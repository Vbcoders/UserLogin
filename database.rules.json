{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "chats": {
      "$messageId": {
        ".validate": "newData.hasChildren(['uid','toUid','timestampMs']) && newData.child('uid').isString() && newData.child('toUid').isString() && newData.child('timestampMs').exists()"
      }
    },
    "users": {
      "$uid": {
        ".write": "auth != null && $uid === auth.uid",
        ".read": "auth != null"
      }
    },
    "e2eeKeys": {
      "$uid": {
        ".write": "auth != null && $uid === auth.uid",
        ".read": "auth != null"
      }
    },
    "presence": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}